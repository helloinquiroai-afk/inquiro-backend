# Placeholder values only. Spring reads process environment variables, not this file automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FACEBOOK_VERIFY_TOKEN=replace-with-a-random-verification-token
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
INQUIRO_MANAGEMENT_API_KEY=replace-with-a-long-random-operator-key
INQUIRO_AUTH_SESSION_TTL_HOURS=24
DEFAULT_BUSINESS_ID=biz_001
WEBSITE_CHANNEL_ID=website-default
SEED_DEFAULT_BUSINESS=true
MESSENGER_WORKER_ENABLED=true
PORT=8080
FORWARD_HEADERS_STRATEGY=none
# Production PostgreSQL example:
# DATABASE_URL=jdbc:postgresql://localhost:5432/inquiro
# DATABASE_USERNAME=inquiro
# DATABASE_PASSWORD=replace-with-a-secret
# DATABASE_DDL_AUTO=validate
# FLYWAY_ENABLED=true
# DATABASE_MAX_POOL_SIZE=10
# DATABASE_MIN_IDLE=2
# DATABASE_CONNECTION_TIMEOUT_MS=30000
#
# Local H2 development:
DATABASE_URL=jdbc:h2:file:./data/inquiro
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DDL_AUTO=validate
FLYWAY_ENABLED=true
DATABASE_MAX_POOL_SIZE=10
DATABASE_MIN_IDLE=2
DATABASE_CONNECTION_TIMEOUT_MS=30000
H2_CONSOLE_ENABLED=false
# Optional legacy WhatsApp integration
INQUIRO_WHATSAPP_ACCESS_TOKEN=
INQUIRO_WHATSAPP_PHONE_NUMBER_ID=
INQUIRO_WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Comma-separated browser origins allowed to call the authenticated API. Keep empty for same-origin only.
INQUIRO_SECURITY_ALLOWED_ORIGINS=

# Required in production: base64-encoded 32-byte AES-256 key. Store in a secret manager.
INQUIRO_CREDENTIAL_ENCRYPTION_KEY=
INQUIRO_CREDENTIAL_KEY_VERSION=1
