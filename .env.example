# Production/local environment template. Never commit real secrets.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DATABASE_URL=jdbc:postgresql://HOST:5432/DB_NAME?sslmode=require
DATABASE_USERNAME=DB_USER
DATABASE_PASSWORD=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4.1-mini
INQUIRO_SECURITY_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
INQUIRO_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
INQUIRO_MANAGEMENT_API_KEY=CHANGE_ME
FACEBOOK_VERIFY_TOKEN=CHANGE_ME
FACEBOOK_PAGE_ACCESS_TOKEN=CHANGE_ME
FACEBOOK_PAGE_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
INQUIRO_WHATSAPP_ACCESS_TOKEN=CHANGE_ME
INQUIRO_WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
INQUIRO_WHATSAPP_VERIFY_TOKEN=CHANGE_ME
SEED_DEFAULT_BUSINESS=false
